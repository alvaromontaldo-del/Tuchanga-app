# Copiá este archivo como ".env" en la raíz de tuchanga-app.
# En una PC nueva: clone del repo → copiá .env.example a .env → completá valores.

# --- Supabase (Project Settings → API) ---
EXPO_PUBLIC_SUPABASE_URL=https://TU_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Chat Node legacy (opcional; la app usa Supabase si está configurado)
# EXPO_PUBLIC_API_URL=

# Mercado Pago en la app
EXPO_PUBLIC_MP_ENABLED=1
EXPO_PUBLIC_APP_SCHEME=tuchanga-app

# Deep link recuperación (opcional)
# EXPO_PUBLIC_AUTH_REDIRECT_URL=tuchanga-app://reset-password

# Mapas (opcional)
# EXPO_PUBLIC_MAPBOX_TOKEN=
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Túnel Expo / ngrok (solo desarrollo local)
# EXPO_NGROK_AUTH_TOKEN=
# EXPO_NGROK_BIN=
# CLOUDFLARED_BIN=

# Migraciones / RLS / pagos: ver supabase/PRODUCCION.md y supabase/PAGOS_MERCADOPAGO.md
# En PC nueva también: npx eas-cli login  +  npx supabase login  +  npx supabase link
