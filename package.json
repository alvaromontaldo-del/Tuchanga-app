{
  "name": "tuchanga-app",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "postinstall": "node scripts/patch-expo-ngrok.js",
    "start": "expo start --lan",
    "start:localhost": "expo start --localhost",
    "start:clear": "expo start --lan --clear",
    "start:lan": "expo start --lan",
    "start:devclient": "expo start --dev-client --lan",
    "start:devclient:clear": "expo start --dev-client --lan --clear",
    "start:tunnel": "node scripts/ensure-expo-tunnel-ready.js && node -r dotenv/config node_modules/expo/bin/cli start --tunnel",
    "start:tunnel:devclient": "node scripts/ensure-expo-tunnel-ready.js && node -r dotenv/config node_modules/expo/bin/cli start --tunnel --dev-client",
    "start:devclient:localtunnel": "node scripts/start-devclient-localtunnel.js",
    "start:devclient:cloudflared": "node scripts/start-devclient-cloudflared.js",
    "android": "expo start --android --lan",
    "ios": "expo start --ios --lan",
    "web": "expo start --web --localhost",
    "eas:update": "node scripts/eas-ota-publish.js",
    "update:preview": "node scripts/eas-ota-publish.js preview",
    "push:android:check": "node scripts/check-android-push-setup.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-google-maps/api": "^2.20.8",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/bottom-tabs": "^7.15.9",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.10",
    "@supabase/supabase-js": "^2.105.1",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.34",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~19.0.22",
    "expo-font": "~14.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.17",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-maps": "1.20.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.1.0",
    "dotenv": "^17.4.1",
    "localtunnel": "^2.0.2",
    "typescript": "~5.9.2",
    "vitest": "^4.1.10"
  },
  "private": true
}
